{
  "SessionStart": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh idle", "timeout": 5 }] }
  ],
  "UserPromptSubmit": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh prompt", "timeout": 5 }] }
  ],
  "PostToolUse": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh working", "timeout": 5 }] }
  ],
  "PreToolUse": [
    {
      "matcher": "AskUserQuestion|ExitPlanMode",
      "hooks": [{ "type": "command", "command": "agent-state.sh waiting", "timeout": 5 }]
    }
  ],
  "PermissionRequest": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh waiting", "timeout": 5 }] }
  ],
  "Notification": [
    {
      "matcher": "elicitation_dialog|agent_needs_input",
      "hooks": [{ "type": "command", "command": "agent-state.sh waiting", "timeout": 5 }]
    },
    {
      "matcher": "idle_prompt",
      "hooks": [{ "type": "command", "command": "agent-state.sh settle", "timeout": 5 }]
    }
  ],
  "Stop": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh done", "timeout": 5 }] }
  ],
  "StopFailure": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh failed", "timeout": 5 }] }
  ],
  "SessionEnd": [
    { "hooks": [{ "type": "command", "command": "agent-state.sh clear", "timeout": 5 }] }
  ]
}
